# Security Configuration for Upload Directory
# Learning Materials Management System

# Prevent direct access to uploaded files
Options -Indexes

# Deny access to sensitive file types
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Redirect all file access requests to download handler
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^.*$ ../download.php?file=%{REQUEST_URI} [L,QSA]

# Additional security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options nosniff
    Header set X-Frame-Options DENY
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Prevent access to system files
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Cache control for better performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/pdf "access plus 1 week"
    ExpiresByType application/msword "access plus 1 week"
    ExpiresByType application/vnd.openxmlformats-officedocument.wordprocessingml.document "access plus 1 week"
</IfModule>